#!/bin/bash
#SBATCH -J r2e_qwen30_mcore
#SBATCH -o logs/r2e_qwen30_mcore_%j.out
#SBATCH -e logs/r2e_qwen30_mcore_%j.err
#SBATCH -N 4
#SBATCH -G 16
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=16
#SBATCH --mem=900G
#SBATCH --exclude=gn002,gn019
#SBATCH -p gpu
#SBATCH --time=24:00:00

set -euo pipefail

PROJECT_DIR="${PROJECT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export PROJECT_DIR
export TRAIN_BACKEND=megatron_core
export TRAIN_GPUS="${TRAIN_GPUS:-8}"
export TRAIN_TP_SIZE="${TRAIN_TP_SIZE:-4}"
export TRAIN_PP_SIZE="${TRAIN_PP_SIZE:-1}"
export TRAIN_CP_SIZE="${TRAIN_CP_SIZE:-1}"
export TRAIN_EP_SIZE="${TRAIN_EP_SIZE:-1}"
export EXPERT_TENSOR_PARALLEL_SIZE="${EXPERT_TENSOR_PARALLEL_SIZE:-4}"
export USE_DISTRIBUTED_OPTIMIZER=1
export MEGATRON_GRAD_REDUCE_IN_FP32="${MEGATRON_GRAD_REDUCE_IN_FP32:-0}"
export MEGATRON_USE_PRECISION_AWARE_OPTIMIZER="${MEGATRON_USE_PRECISION_AWARE_OPTIMIZER:-1}"
export MEGATRON_OPTIMIZER_CPU_OFFLOAD="${MEGATRON_OPTIMIZER_CPU_OFFLOAD:-1}"
export MEGATRON_OPTIMIZER_OFFLOAD_FRACTION="${MEGATRON_OPTIMIZER_OFFLOAD_FRACTION:-1.0}"
export MEGATRON_OPTIMIZER_PIN_CPU_GRADS="${MEGATRON_OPTIMIZER_PIN_CPU_GRADS:-0}"
export MEGATRON_OPTIMIZER_PIN_CPU_PARAMS="${MEGATRON_OPTIMIZER_PIN_CPU_PARAMS:-0}"
export MEGATRON_ROLLOUT_EXPORT_ONLY="${MEGATRON_ROLLOUT_EXPORT_ONLY:-1}"
export MCORE_MOE_GROUPED_GEMM="${MCORE_MOE_GROUPED_GEMM:-1}"
export TOTAL_STEPS="${TOTAL_STEPS:-100}"
export MAX_MODEL_LEN="${MAX_MODEL_LEN:-8192}"
export MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-1024}"
export R2E_MAX_TURNS="${R2E_MAX_TURNS:-2}"
export R2E_MAX_PROMPT_TOKENS="${R2E_MAX_PROMPT_TOKENS:-2048}"
export SYNC_INTERVAL="${SYNC_INTERVAL:-5}"
export NCCL_P2P_DISABLE="${NCCL_P2P_DISABLE:-1}"
export NCCL_IB_DISABLE="${NCCL_IB_DISABLE:-0}"
export NCCL_PREFLIGHT_ELEMENTS="${NCCL_PREFLIGHT_ELEMENTS:-1048576}"
export NCCL_PREFLIGHT_ITERATIONS="${NCCL_PREFLIGHT_ITERATIONS:-1}"
export NCCL_PREFLIGHT_WALLTIME="${NCCL_PREFLIGHT_WALLTIME:-300}"
export GRP_ONLINE_REPLANNING="${GRP_ONLINE_REPLANNING:-1}"
export GRP_DYNAMIC_RECONFIG_ENABLED="${GRP_DYNAMIC_RECONFIG_ENABLED:-0}"
export GRP_MANAGE_ROLLOUT_PROCESSES="${GRP_MANAGE_ROLLOUT_PROCESSES:-0}"
export GRP_RECONFIGURE_TRAINING="${GRP_RECONFIGURE_TRAINING:-0}"
export GRP_CLUSTER_SWAP_ENABLED="${GRP_CLUSTER_SWAP_ENABLED:-0}"
export GRP_DECOUPLE_COMMUNICATION_DOMAINS="${GRP_DECOUPLE_COMMUNICATION_DOMAINS:-1}"
export GRP_ROLLOUT_RECONFIGURE_STRATEGY="${GRP_ROLLOUT_RECONFIGURE_STRATEGY:-blue_green}"

exec bash "$PROJECT_DIR/scripts/submit_r2e_gym_cmlfq_24gpu_qwen3_30b_a3b.slurm"
