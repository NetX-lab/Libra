#!/bin/bash
# Short Qwen3-4B pilot for Libra validation.

#SBATCH -J libra_pilot
#SBATCH -o logs/libra_pilot_%j.out
#SBATCH -e logs/libra_pilot_%j.err
#SBATCH -N 3
#SBATCH -G 12
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=16
#SBATCH --mem=900G
#SBATCH --exclude=gn002,gn019
#SBATCH -p gpu
#SBATCH --time=01:00:00

set -euo pipefail

export PROJECT_DIR="${PROJECT_DIR:-/home-ssd/Users/nsgm_xu/kwchen/RL_Framework}"
export EXPERIMENT_TAG="${EXPERIMENT_TAG:-pilot_libra_full_qwen4}"
export MODEL_PATH="${MODEL_PATH:-/home-ssd/Users/nsgm_xu/kwchen/hf_models/Qwen3-4B}"
export MODEL_ARCH_CONFIG="${MODEL_ARCH_CONFIG:-model_arch_config/qwen3-4b.yaml}"
export TOTAL_STEPS="${TOTAL_STEPS:-6}"
export MAX_MODEL_LEN="${MAX_MODEL_LEN:-4096}"
export MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-128}"
export R2E_MAX_PROMPT_TOKENS="${R2E_MAX_PROMPT_TOKENS:-1024}"
export R2E_MAX_TURNS="${R2E_MAX_TURNS:-1}"
export TRAIN_BATCH_SIZE="${TRAIN_BATCH_SIZE:-8}"
export N_SAMPLES="${N_SAMPLES:-2}"
export MAX_CONCURRENT_ROLLOUTS="${MAX_CONCURRENT_ROLLOUTS:-8}"
export QUEUE_SIZE="${QUEUE_SIZE:-32}"
export EVAL_INTERVAL="${EVAL_INTERVAL:-999}"
export SYNC_INTERVAL="${SYNC_INTERVAL:-999}"
export RUN_NCCL_PREFLIGHT="${RUN_NCCL_PREFLIGHT:-0}"

export TRAIN_BACKEND="${TRAIN_BACKEND:-megatron_core}"
export TRAIN_GPUS="${TRAIN_GPUS:-4}"
export TRAIN_TP_SIZE="${TRAIN_TP_SIZE:-1}"
export TRAIN_PP_SIZE="${TRAIN_PP_SIZE:-1}"
export TRAIN_CP_SIZE="${TRAIN_CP_SIZE:-1}"
export MEGATRON_USE_PRECISION_AWARE_OPTIMIZER="${MEGATRON_USE_PRECISION_AWARE_OPTIMIZER:-1}"
export MEGATRON_OPTIMIZER_CPU_OFFLOAD="${MEGATRON_OPTIMIZER_CPU_OFFLOAD:-1}"
export MEGATRON_OPTIMIZER_OFFLOAD_FRACTION="${MEGATRON_OPTIMIZER_OFFLOAD_FRACTION:-1.0}"

export SCHEDULER_TYPE="${SCHEDULER_TYPE:-cmlfq}"
export GRP_ENABLED="${GRP_ENABLED:-1}"
export GRP_DYNAMIC_RECONFIG_ENABLED="${GRP_DYNAMIC_RECONFIG_ENABLED:-1}"
export GRP_RUNTIME_ASYNC_PLANNING="${GRP_RUNTIME_ASYNC_PLANNING:-0}"
export GRP_ONLINE_REPLANNING="${GRP_ONLINE_REPLANNING:-1}"
export GRP_INTERVAL="${GRP_INTERVAL:-1}"
export GRP_WARMUP_STEPS="${GRP_WARMUP_STEPS:-0}"
export GRP_MIN_HISTORY="${GRP_MIN_HISTORY:-4}"
export GRP_MIN_GAIN_RATIO="${GRP_MIN_GAIN_RATIO:-0.0}"
export GRP_MANAGE_ROLLOUT_PROCESSES="${GRP_MANAGE_ROLLOUT_PROCESSES:-1}"
export GRP_RECONFIGURE_TRAINING="${GRP_RECONFIGURE_TRAINING:-1}"
export GRP_TRAINING_POOL_PLAN_ONLY="${GRP_TRAINING_POOL_PLAN_ONLY:-0}"
export GRP_CLUSTER_SWAP_ENABLED="${GRP_CLUSTER_SWAP_ENABLED:-1}"
export GRP_ROLLOUT_RECONFIGURE_STRATEGY="${GRP_ROLLOUT_RECONFIGURE_STRATEGY:-cluster_swap}"
export GRP_DRAIN_BEFORE_RECONFIGURE="${GRP_DRAIN_BEFORE_RECONFIGURE:-0}"
export GRP_BATCH_COLLECTION_TIMEOUT_S="${GRP_BATCH_COLLECTION_TIMEOUT_S:-180}"
export GRP_BATCH_COLLECTION_MAX_RETRIES="${GRP_BATCH_COLLECTION_MAX_RETRIES:-1}"
export GRP_INITIAL_ROLLOUT_TP_LIST="${GRP_INITIAL_ROLLOUT_TP_LIST:-4:2:2}"
export GRP_FORCE_RUNTIME_RECONFIGURE="${GRP_FORCE_RUNTIME_RECONFIGURE:-1}"
export GRP_FORCE_TRAIN_GPUS="${GRP_FORCE_TRAIN_GPUS:-8}"
export GRP_FORCE_ROLLOUT_TP_LIST="${GRP_FORCE_ROLLOUT_TP_LIST:-2:2}"
export GRP_TRAINING_POOL_TARGET_GPUS="${GRP_TRAINING_POOL_TARGET_GPUS:-8}"
export GRP_DECOUPLE_COMMUNICATION_DOMAINS="${GRP_DECOUPLE_COMMUNICATION_DOMAINS:-1}"

export ROLLOUT_WEIGHT_SYNC_MODE="${ROLLOUT_WEIGHT_SYNC_MODE:-none}"
export REQUIRE_ROLLOUT_WEIGHT_SYNC="${REQUIRE_ROLLOUT_WEIGHT_SYNC:-0}"

exec bash "$PROJECT_DIR/scripts/submit_r2e_gym_cmlfq_24gpu_qwen3_30b_a3b.slurm"
