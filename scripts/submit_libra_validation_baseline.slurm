#!/bin/bash
# Baseline Qwen3-4B validation run: fixed layout, no C-MLFQ/GRP/EHP.

#SBATCH -J libra_base
#SBATCH -o logs/libra_base_%j.out
#SBATCH -e logs/libra_base_%j.err
#SBATCH -N 3
#SBATCH -G 12
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=16
#SBATCH --mem=900G
#SBATCH -p gpu
#SBATCH --time=01:00:00

set -euo pipefail

export PROJECT_DIR="${PROJECT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export EXPERIMENT_TAG="${EXPERIMENT_TAG:-baseline_lenaware_qwen4}"
export MODEL_PATH="${MODEL_PATH:-/path/to/Qwen3-4B}"
export MODEL_ARCH_CONFIG="${MODEL_ARCH_CONFIG:-model_arch_config/qwen3-4b.yaml}"
export TOTAL_STEPS="${TOTAL_STEPS:-12}"
export MAX_MODEL_LEN="${MAX_MODEL_LEN:-4096}"
export MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-512}"
export R2E_MAX_PROMPT_TOKENS="${R2E_MAX_PROMPT_TOKENS:-1024}"
export R2E_MAX_TURNS="${R2E_MAX_TURNS:-2}"
export TRAIN_BATCH_SIZE="${TRAIN_BATCH_SIZE:-8}"
export N_SAMPLES="${N_SAMPLES:-2}"
export MAX_CONCURRENT_ROLLOUTS="${MAX_CONCURRENT_ROLLOUTS:-8}"
export QUEUE_SIZE="${QUEUE_SIZE:-32}"
export EVAL_INTERVAL="${EVAL_INTERVAL:-999}"
export SYNC_INTERVAL="${SYNC_INTERVAL:-999}"
export RUN_NCCL_PREFLIGHT="${RUN_NCCL_PREFLIGHT:-0}"
export ALLOW_QWEN30_FALLBACK="${ALLOW_QWEN30_FALLBACK:-1}"

export TRAIN_BACKEND="${TRAIN_BACKEND:-megatron_core}"
export TRAIN_GPUS="${TRAIN_GPUS:-4}"
export TRAIN_TP_SIZE="${TRAIN_TP_SIZE:-4}"
export TRAIN_PP_SIZE="${TRAIN_PP_SIZE:-1}"
export TRAIN_CP_SIZE="${TRAIN_CP_SIZE:-1}"
export MEGATRON_USE_PRECISION_AWARE_OPTIMIZER="${MEGATRON_USE_PRECISION_AWARE_OPTIMIZER:-1}"
export MEGATRON_OPTIMIZER_CPU_OFFLOAD="${MEGATRON_OPTIMIZER_CPU_OFFLOAD:-1}"
export MEGATRON_OPTIMIZER_OFFLOAD_FRACTION="${MEGATRON_OPTIMIZER_OFFLOAD_FRACTION:-1.0}"

export SCHEDULER_TYPE="${SCHEDULER_TYPE:-length_aware}"
export GRP_ENABLED="${GRP_ENABLED:-0}"
export GRP_DYNAMIC_RECONFIG_ENABLED="${GRP_DYNAMIC_RECONFIG_ENABLED:-0}"
export GRP_RUNTIME_ASYNC_PLANNING="${GRP_RUNTIME_ASYNC_PLANNING:-0}"
export GRP_ONLINE_REPLANNING="${GRP_ONLINE_REPLANNING:-0}"
export GRP_MANAGE_ROLLOUT_PROCESSES="${GRP_MANAGE_ROLLOUT_PROCESSES:-0}"
export GRP_RECONFIGURE_TRAINING="${GRP_RECONFIGURE_TRAINING:-0}"
export GRP_TRAINING_POOL_PLAN_ONLY="${GRP_TRAINING_POOL_PLAN_ONLY:-1}"
export GRP_CLUSTER_SWAP_ENABLED="${GRP_CLUSTER_SWAP_ENABLED:-0}"
export GRP_HYBRID_WORKER_LAUNCH_ENABLED="${GRP_HYBRID_WORKER_LAUNCH_ENABLED:-0}"
export GRP_HYBRID_TRAINING_PREWARM_ENABLED="${GRP_HYBRID_TRAINING_PREWARM_ENABLED:-0}"
export GRP_INITIAL_ROLLOUT_TP_LIST="${GRP_INITIAL_ROLLOUT_TP_LIST:-4:2:2}"
export GRP_FORCE_RUNTIME_RECONFIGURE="${GRP_FORCE_RUNTIME_RECONFIGURE:-0}"
export GRP_TRAINING_POOL_TARGET_GPUS="${GRP_TRAINING_POOL_TARGET_GPUS:-0}"

export ROLLOUT_WEIGHT_SYNC_MODE="${ROLLOUT_WEIGHT_SYNC_MODE:-none}"
export REQUIRE_ROLLOUT_WEIGHT_SYNC="${REQUIRE_ROLLOUT_WEIGHT_SYNC:-0}"

exec bash "$PROJECT_DIR/scripts/submit_r2e_gym_cmlfq_24gpu_qwen3_30b_a3b.slurm"
